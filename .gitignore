# macOS
.DS_Store

# Xcode (generated by XcodeGen — run `xcodegen generate` in apps/mac)
*.xcodeproj
xcuserdata/
DerivedData/

# Swift Package Manager
.build/
.swiftpm/

# Node
node_modules/
dist/

# Env / local
.env
*.local

# Release build output (apps/mac/scripts/release-dmg.sh)
apps/mac/build/

# SwiftPM on Windows copies resource bundles next to the package
apps/mac/Packages/*/Info.plist
apps/mac/Packages/LocalAPI/document-schemas.json
