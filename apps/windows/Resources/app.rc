// Resources linked into mxu-slides.exe: the app icon (named, as
// WebView2Host.cpp loads it) and the version block Explorer shows.
#include <windows.h>

AppIcon ICON "app.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MxU"
            VALUE "FileDescription", "MxU Slides"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "mxu-slides"
            VALUE "LegalCopyright", "PolyForm Shield License 1.0.0"
            VALUE "OriginalFilename", "MxU Slides.exe"
            VALUE "ProductName", "MxU Slides"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
